// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-1.1.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  personId Int?    @unique
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  roles UserRole[]
}

model Person {
  id             Int                @id @default(autoincrement())
  uid            String             @unique
  slug           String?            @unique
  email          String?            @unique
  displayName    String?
  firstName      String?
  lastName       String?
  normalizedName String?
  identifiers    PersonIdentifier[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  external       Boolean            @default(false)
  user           User?
  contributions  Contribution[]
  memberships    Membership[]
  employments    Employment[]
  records        SourcePerson[]
  deposits       HalDeposit[]
}

model Membership {
  id                 Int              @id @default(autoincrement())
  personId           Int
  organizationUnitId Int
  startDate          DateTime?
  endDate            DateTime?
  positionCode       String?
  person             Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Cascade)

  @@unique([personId, organizationUnitId])
  @@index([organizationUnitId])
  @@index([personId])
}

model Employment {
  id                 Int              @id @default(autoincrement())
  personId           Int
  organizationUnitId Int
  startDate          DateTime?
  endDate            DateTime?
  positionCode       String?
  person             Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Cascade)

  @@unique([personId, organizationUnitId])
  @@index([organizationUnitId])
  @@index([personId])
}

enum DocumentState {
  default
  waiting_for_update
}

enum OAStatus {
  GREEN   @map("green")
  DIAMOND @map("diamond")
  GOLD    @map("gold")
  BRONZE  @map("bronze")
  HYBRID  @map("hybrid")
  OTHER   @map("other")
  CLOSED  @map("closed")
}

model Document {
  id                   Int                @id @default(autoincrement())
  uid                  String             @unique
  documentType         DocumentType       @default(Document)
  oaStatus             OAStatus?
  publicationDate      String?
  publicationDateStart DateTime?
  publicationDateEnd   DateTime?
  upwOAStatus          OAStatus?
  titles               DocumentTitle[]
  abstracts            DocumentAbstract[]
  contributions        Contribution[]
  subjects             Concept[]
  title_locale_0       String?
  title_locale_1       String?
  title_locale_2       String?
  records              DocumentRecord[]
  state                DocumentState      @default(default)
  deposits             HalDeposit[]

  journalId Int?
  journal   Journal? @relation(fields: [journalId], references: [id], onDelete: SetNull)
  volume    String?
  issue     String?
  pages     String?
}

enum HalDepositStatus {
  pending
  running
  accept
  verify
  update
  delete
  replace
  error
}

model HalDeposit {
  id         Int              @id @default(autoincrement())
  documentId Int
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  personId   Int
  person     Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  status     HalDepositStatus @default(pending)

  // Returned by SWORD
  halId       String?
  halPassword String?
  halVersion  Int?
  halUrl      String?

  // Async processing bookkeeping
  startedAt          DateTime?
  retryCount         Int       @default(0)
  nextRetryAt        DateTime?
  lastError          String? // last SWORD/transport error (our side), for debugging
  comment            String? // moderator comment / rejection reason from HAL status response
  refreshRequestedAt DateTime?

  // Deposit-specific metadata used to generate the TEI
  halDocumentType     String
  halDomains          String[]
  language            String
  conferenceTitle     String?
  conferenceCity      String?
  conferenceStartDate String? // partial ISO 8601 (YYYY / YYYY-MM / YYYY-MM-DD)
  conferenceCountry   String? // ISO 3166-1 alpha-2 country code
  institution         String?
  bookTitle           String?
  supervisor          String? // THESE thesis advisor / HDR chair of jury display name

  files     HalDepositFile[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
  @@index([refreshRequestedAt])
}

model HalDepositFile {
  id           Int        @id @default(autoincrement())
  halDepositId Int
  halDeposit   HalDeposit @relation(fields: [halDepositId], references: [id], onDelete: Cascade)
  filePath     String
  fileName     String
  isMain       Boolean    @default(false)
  mimeType     String
  fileSource   String // HAL fileSource code -> TEI ref/@subtype
  fileType     String // HAL fileType code -> TEI ref/@type (file/src/annex)
  visibility   String // embargo option (now/15d/1m/3m/6m/1y/2y)
  license      String? // CC/ETALAB/Copyright code -> availability/licence/@target
  createdAt    DateTime   @default(now())
}

model Journal {
  id          Int                 @id @default(autoincrement())
  issnL       String              @unique
  publisher   String
  title       String
  identifiers JournalIdentifier[]
  documents   Document[]
}

model JournalIdentifier {
  id        Int     @id @default(autoincrement())
  type      String
  value     String
  format    String?
  journalId Int
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

enum DocumentType {
  Document
  ScholarlyPublication
  Presentation
  Article
  ConferenceAbstract
  Preface
  Comment
  JournalArticle
  Book
  Monograph
  BookChapter
  BookOfChapters
  ConferenceArticle
  Proceedings
}

enum SourceRecordType {
  Article
  AudiovisualDocument
  Book
  Chapter
  Document
  Excerpt
  Letter
  Manual
  Map
  Note
  Patent
  Proceedings
  Standard
  Thesis
  BlogPost
  ConferenceOutput
  DataPaper
  Lecture
  MasterThesis
  Other
  PeerReview
  Report
  ResearchReport
  Software
  TechnicalReport
  BookReview
  ConferencePaper
  ConferencePoster
  DataManagementPlan
  Dataset
  Editorial
  Erratum
  Image
  MetadataDocument
  Preprint
  ReferenceBook
  ReviewArticle
  ReviewPaper
  StillImage
  WorkingPaper
  Grant
  Work
  Unknown
}

enum HalSubmitType {
  file
  notice
  annex
}

model SourcePerson {
  id                 Int                      @id @default(autoincrement())
  uid                String                   @unique
  name               String
  source             String
  sourceId           String?
  identifiers        SourcePersonIdentifier[]
  SourceContribution SourceContribution[]
  person             Person?                  @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId           Int?
}

enum SourcePersonIdentifierType {
  openalex
  idref
  orcid
  idhals
  idhali
  isni
  viaf
  googlescholar
  researcherid
}

model SourcePersonIdentifier {
  id            Int                        @id @default(autoincrement())
  type          SourcePersonIdentifierType
  value         String
  sourcePersons SourcePerson[]

  @@unique([type, value]) // The same identifer should not be used twice
}

model SourceContribution {
  id               Int            @id @default(autoincrement())
  role             String
  person           SourcePerson   @relation(fields: [sourcePersonId], references: [id], onDelete: Cascade)
  sourcePersonId   Int
  DocumentRecord   DocumentRecord @relation(fields: [documentRecordId], references: [id], onDelete: Cascade)
  documentRecordId Int
}

model SourceJournal {
  id             Int              @id @default(autoincrement())
  uid            String           @unique
  source         String
  sourceId       String
  publisher      String?
  titles         String[]
  DocumentRecord DocumentRecord[]
}

enum PublicationIdentifierType {
  arxiv
  bibcode
  biorxiv
  cern
  chemrxiv
  doi
  ensam
  hal
  ineris
  inspire
  ird
  irstea
  irthesaurus
  meditagri
  nnt
  oatao
  okina
  openalex
  pii
  pmid
  ppn
  prodinra
  pubmedcentral
  sciencespo
  swhid
  uri
  wos
  unknown
}

model PublicationIdentifier {
  id             Int                       @id @default(autoincrement())
  type           PublicationIdentifierType
  value          String?
  DocumentRecord DocumentRecord[]

  @@unique([type, value]) // The same identifer should not be used twice
}

model DocumentRecord {
  id                 Int                     @id @default(autoincrement())
  uid                String                  @unique
  url                String?
  sourceIdentifier   String
  identifiers        PublicationIdentifier[]
  contributions      SourceContribution[]
  documentTypes      SourceRecordType[]
  sourceJournalId    Int?
  journal            SourceJournal?          @relation(fields: [sourceJournalId], references: [id])
  publicationDate    DateTime?
  platform           BibliographicPlatform
  titles             Json
  halCollectionCodes String[]
  halSubmitType      HalSubmitType?
  documentId         Int
  document           Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

enum BibliographicPlatform {
  hal
  scanr
  idref
  openalex
  scopus
}

model DocumentTitle {
  id         Int      @id @default(autoincrement())
  documentId Int
  language   String // ISO 639-1 code (e.g., 'en', 'fr')
  value      String   @db.VarChar(2000)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, language]) // Ensure no duplicate languages for the same document
}

model DocumentAbstract {
  id         Int      @id @default(autoincrement())
  documentId Int
  language   String // ISO 639-1 code (e.g., 'en', 'fr')
  value      String   @db.Text
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, language]) // Ensure no duplicate languages for the same document
}

enum AuthorityOrganizationIdentifierType {
  hal
  idref
  isni
  local
  nns
  openalex
  ror
  scopus
  siren
  siret
  uai
  viaf
  wikidata
}

model AuthorityOrganizationIdentifier {
  id            Int                                 @id @default(autoincrement())
  type          AuthorityOrganizationIdentifierType
  value         String
  organizations AuthorityOrganization[]

  @@unique([type, value])
}

enum AuthorityOrganizationNameType {
  authority_organization_state_name
}

model AuthorityOrganizationName {
  id             Int                           @id @default(autoincrement())
  type           AuthorityOrganizationNameType
  language       String // ISO 639-1 code (e.g., 'en', 'fr')
  value          String
  organization   AuthorityOrganization         @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  organizationId Int

  @@unique([language, value, organizationId])
}

enum AuthorityOrganizationType {
  organization
  research_team_group
  laboratory
  research_team
  institution
  laboratory_group
  institution_group
}

model AuthorityOrganization {
  id            Int                               @id @default(autoincrement())
  uid           String                            @unique
  displayNames  String[]
  type          AuthorityOrganizationType?
  names         AuthorityOrganizationName[]
  places        Json
  identifiers   AuthorityOrganizationIdentifier[]
  contributions Contribution[]
}

model Contribution {
  id           Int                     @id @default(autoincrement())
  personId     Int
  documentId   Int
  roles        String[]
  rank         Int?
  affiliations AuthorityOrganization[]
  person       Person                  @relation(fields: [personId], references: [id], onDelete: Cascade)
  document     Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([personId, documentId]) // Ensure unique person-document pair
  @@index([documentId])
}

model Concept {
  id        Int            @id @default(autoincrement())
  uid       String         @unique
  uri       String?
  labels    ConceptLabel[]
  documents Document[]
}

model ConceptLabel {
  id        Int       @id @default(autoincrement())
  conceptId Int
  concept   Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  language  String // ISO 639-1 code
  value     String
  type      LabelType

  @@unique([conceptId, language, type, value])
  @@index([conceptId])
}

enum LabelType {
  PREF
  ALT
}

enum PersonIdentifierType {
  eppn
  hal_login
  idref
  idhals
  idhali
  local
  orcid
  scopus
}

model PersonIdentifier {
  id       Int                  @id @default(autoincrement())
  type     PersonIdentifierType
  value    String
  person   Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId Int

  orcidIdentifier OrcidIdentifier?

  @@unique([type, value]) // The same identifer should not be used twice
  @@unique([personId, type]) // A person should not have more than one identifier of the same type
  @@index([personId])
}

model OrcidIdentifier {
  // same primary key as base row (1–1)
  id         Int              @id
  identifier PersonIdentifier @relation(fields: [id], references: [id], onDelete: Cascade)

  // encrypt tokens !
  accessToken  String?
  refreshToken String?
  scope        String
  tokenType    String?

  obtainedAt DateTime @default(now())
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrganizationGenericType {
  institution
  institution_subdivision
  unit
  unit_subdivision
  team
}

// Concrete category, derived from the graph labels at sync time.
enum OrganizationCategory {
  institution
  institution_subdivision
  research_unit
  support_unit
  administrative_unit
  teaching_unit
  unit_subdivision
  team
}

enum OrganizationLabelKind {
  short
  long
}

enum OrganizationRelationKind {
  part_of
  member_of
}

model OrganizationUnit {
  id           Int                     @id @default(autoincrement())
  uid          String                  @unique
  genericType  OrganizationGenericType
  category     OrganizationCategory
  nationalType String? // open national list (UNIV, EPE, UMR, UAR, UFR, …) — evolves upstream
  external     Boolean                 @default(false)
  acronym      String?
  slug         String?                 @unique
  localTypes   Json? // [{ value, language }] — display only

  labels       OrganizationUnitLabel[]
  descriptions OrganizationUnitDescription[]
  identifiers  OrganizationUnitIdentifier[]

  parents  OrganizationRelationship[] @relation("child")
  children OrganizationRelationship[] @relation("parent")

  memberships Membership[]
  employments Employment[]
}

model OrganizationUnitLabel {
  id                 Int                   @id @default(autoincrement())
  organizationUnitId Int
  kind               OrganizationLabelKind
  language           String // ISO 639-1 code
  value              String                @db.VarChar(255)
  organizationUnit   OrganizationUnit      @relation(fields: [organizationUnitId], references: [id], onDelete: Cascade)

  @@unique([organizationUnitId, kind, language])
}

model OrganizationUnitDescription {
  id                 Int              @id @default(autoincrement())
  organizationUnitId Int
  language           String // ISO 639-1 code
  value              String           @db.VarChar(2000)
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Cascade)

  @@unique([organizationUnitId, language])
}

model OrganizationUnitIdentifier {
  id                 Int                        @id @default(autoincrement())
  type               OrganizationIdentifierType
  value              String
  organizationUnit   OrganizationUnit           @relation(fields: [organizationUnitId], references: [id], onDelete: Cascade)
  organizationUnitId Int

  @@unique([type, value])
}

enum OrganizationIdentifierType {
  hal
  idref
  isni
  local
  nns
  openalex
  ror
  scopus
  siren
  siret
  uai
  viaf
  wikidata
}

model OrganizationRelationship {
  id        Int                      @id @default(autoincrement())
  childId   Int
  parentId  Int
  kind      OrganizationRelationKind
  position  String? // main_supervision | associated_supervision | participating_supervision
  startDate DateTime?
  endDate   DateTime?

  child  OrganizationUnit @relation("child", fields: [childId], references: [id], onDelete: Cascade)
  parent OrganizationUnit @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([childId, parentId, kind])
  @@index([parentId])
}

enum ActionType {
  ADD
  REMOVE
  UPDATE
  FETCH
  MERGE
}

enum ActionTargetType {
  DOCUMENT
  PERSON
  HARVESTING
}

model Action {
  id         String           @id @default(uuid())
  actionType ActionType
  targetType ActionTargetType
  targetUid  String
  path       String?
  parameters Json
  timestamp  DateTime         @default(now())
  dispatched Boolean          @default(false)
  personUid  String

  @@index([actionType])
  @@index([targetType])
  @@index([targetUid])
  @@index([timestamp])
}

enum PermissionAction {
  manage
  read
  create
  update
  delete
  merge
  unmerge
  fetch_documents
  deposit_hal
  deposit_hal_unauthenticated
}

enum PermissionSubject {
  all
  Document
  DocumentRecord
  Person
  ResearchUnit
  Membership
  Institution
  InstitutionDivision
}

enum EntityType {
  Person
  ResearchUnit
  Institution
  InstitutionDivision
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          Int               @id @default(autoincrement())
  action      PermissionAction
  subject     PermissionSubject
  fields      String[]          @default([])
  inverted    Boolean           @default(false)
  conditions  Json?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  scopes UserRoleScope[]

  @@id([userId, roleId])
  @@index([roleId])
}

model UserRoleScope {
  id         Int        @id @default(autoincrement())
  userId     Int
  roleId     Int
  entityType EntityType
  entityUid  String

  userRole UserRole @relation(fields: [userId, roleId], references: [userId, roleId], onDelete: Cascade)

  @@unique([userId, roleId, entityType, entityUid])
  @@index([entityType, entityUid])
}
